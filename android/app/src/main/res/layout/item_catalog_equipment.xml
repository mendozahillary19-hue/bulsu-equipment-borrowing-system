<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card_light_gray"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- White Square Image Frame -->
    <LinearLayout
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/bg_card_rounded"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivCatalogImage"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:contentDescription="Equipment Image"
            android:scaleType="fitCenter"
            android:src="@drawable/img_multimeter" />
    </LinearLayout>

    <!-- Info & Borrow Button Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Equipment Title -->
        <TextView
            android:id="@+id/tvCatalogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Digital Multimeter"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Category -->
        <TextView
            android:id="@+id/tvCatalogCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="serif"
            android:text="Category: Tools &amp; Repairs"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- Available Stock -->
        <TextView
            android:id="@+id/tvCatalogAvailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="serif"
            android:text="Available: 26"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- Borrow Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCatalogBorrow"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/btn_borrow"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</LinearLayout>
