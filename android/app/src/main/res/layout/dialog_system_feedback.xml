<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modal_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Status / Warning Icon -->
    <ImageView
        android:id="@+id/ivFeedbackIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="Feedback Icon"
        android:src="@drawable/ic_feedback_warning" />

    <!-- Alert Title -->
    <TextView
        android:id="@+id/tvFeedbackTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="Stock Limit Notice"
        android:textColor="@color/bulsu_navy"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Optional Subtitle / Tagline -->
    <TextView
        android:id="@+id/tvFeedbackSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_badge_pending"
        android:fontFamily="serif"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:paddingBottom="2dp"
        android:text="Available: 26 Units"
        android:textColor="@color/status_pending_text"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Detailed Message -->
    <TextView
        android:id="@+id/tvFeedbackMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="serif"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="You have reached the maximum available inventory for this equipment. You cannot borrow more than the remaining stock."
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFeedbackNegative"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFeedbackPositive"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:text="OK"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
