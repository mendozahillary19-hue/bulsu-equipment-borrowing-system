<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card_light_gray"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- White Square Image Frame -->
    <LinearLayout
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:background="@drawable/bg_card_rounded"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivHistoryImage"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="Equipment Image"
            android:scaleType="fitCenter"
            android:src="@drawable/img_multimeter" />
    </LinearLayout>

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Equipment Title -->
        <TextView
            android:id="@+id/tvHistoryEquipmentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Digital Multimeter"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Quantity -->
        <TextView
            android:id="@+id/tvHistoryQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="serif"
            android:text="Qty: 1"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- Date Range -->
        <TextView
            android:id="@+id/tvHistoryDateRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="serif"
            android:text="Oct 20-Oct 24, 2026"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvHistoryStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge_pending"
            android:fontFamily="serif"
            android:paddingStart="14dp"
            android:paddingTop="3dp"
            android:paddingEnd="14dp"
            android:paddingBottom="3dp"
            android:text="Pending"
            android:textColor="@color/status_pending_text"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Chevron Arrow -->
    <ImageView
        android:id="@+id/ivHistoryChevron"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:contentDescription="Open Details"
        android:src="@drawable/ic_chevron_right" />

</LinearLayout>
